# Telegram Marketplace — Environment Variables
# Copy to .env and fill in values

# Telegram
TELEGRAM_BOT_TOKEN=
MINI_APP_URL=http://localhost:3000

# Auth
JWT_SECRET=change-me-jwt-secret
ADMIN_JWT_SECRET=change-me-admin-jwt-secret
BOT_INTERNAL_SECRET=bot-secret

# API
NEXT_PUBLIC_API_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# SBP Payment (provider TBD)
SBP_MOCK_MODE=true
SBP_WEBHOOK_SECRET=dev-sbp-secret
SBP_PROVIDER_API_KEY=
SBP_PROVIDER_SECRET=

# Fragment API (Premium & Gifts delivery)
FRAGMENT_API_URL=https://fragment.com/api
FRAGMENT_API_TOKEN=

# S3 / MinIO
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=catalog
S3_PUBLIC_URL=http://localhost:9000/catalog
S3_USE_SSL=false

# Database
POSTGRES_USER=markettg
POSTGRES_PASSWORD=markettg
POSTGRES_DB=markettg

# Monitoring
GRAFANA_PASSWORD=admin

# Production only
# DOMAIN=example.com
# ADMIN_DOMAIN=admin.example.com
