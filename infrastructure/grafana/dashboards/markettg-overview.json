{
  "annotations": {
    "list": []
  },
  "title": "MarketTG Overview",
  "uid": "markettg-overview",
  "panels": [
    {
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[5m])) by (service)",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "title": "Payment Failures",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(payment_failures_total[1h]))"
        }
      ]
    },
    {
      "title": "Delivery Failures",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(delivery_failures_total[1h]))"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
